# Backend environment: every variable with its default. To change one, add that line to .env (don't copy this file
# over it: .env holds the SESSION_ENCRYPTION_KEY that `pnpm dev` generated, and replacing it makes every stored
# session unreadable). Every default matches the infra ports, so .env needs nothing else.

# Port the Fastify backend listens on.
PORT=4000

# Connection modes to run, comma-separated: any of standalone, sentinel, cluster.
SHOWCASE_MODES=standalone,sentinel,cluster

# Standalone Redis.
REDIS_URL=redis://127.0.0.1:6379

# Sentinel: the sentinels (host:port, comma-separated) and the master name they monitor.
REDIS_SENTINELS=127.0.0.1:26379,127.0.0.1:26380,127.0.0.1:26381
REDIS_SENTINEL_NAME=mymaster

# Cluster seed nodes (host:port, comma-separated).
REDIS_CLUSTER_NODES=127.0.0.1:7001,127.0.0.1:7002,127.0.0.1:7003

# Session lifetime in seconds: TTL, idle timeout, absolute timeout, and how often a used session's expiry is extended.
SESSION_TTL=3600
SESSION_IDLE_TIMEOUT=900
SESSION_ABSOLUTE_TIMEOUT=3600
SESSION_TOUCH_INTERVAL=10

# 32 random bytes, base64. No default: generated into .env by scripts/ensure-env.mjs.
SESSION_ENCRYPTION_KEY=

# Mark session cookies Secure (needs HTTPS). Off for local development.
COOKIE_SECURE=false
